# regex for trufflehog exclusion
# Directories (match anywhere in path)
\.git/
node_modules/
dist/
coverage/
\.vscode/
\.idea/
\.claude/

# Env files (contain secrets by design)
\.env$
\.env\..*

# Gemini workspace
\.gemini/

# Lock files
\.lock$

# Images/assets
\.(png|jpg|jpeg|gif|svg|ico|woff2?|ttf|eot)$

# Binary files
\.(exe|dll|so|dylib)$

# Firebase service account (local dev only)
firebase.*\.json$
