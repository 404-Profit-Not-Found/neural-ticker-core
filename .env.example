APP_ENV='local'
DB_HOST='localhost'
DB_PORT='5432'
DB_USERNAME='postgres'
DB_PASSWORD='your_password'
DB_DATABASE='neural_ticket_test'
DB_SSL='false'
# Leave this 'false'. The schema is built by migrations at boot (an empty
# database works). TypeORM `synchronize` is NOT a safe shortcut here: the
# migrated schema differs from the entities in a few places, so turning it on
# against a database with data would drop two unique indexes and drop and
# re-add several timestamp columns (losing their values). It is always forced
# off in production.
DB_SYNCHRONIZE='false'
DATABASE_URL='postgres://postgres:your_password@localhost:5432/neural_ticket_test?sslmode=disable'
FIREBASE_PROJECT_ID='your_firebase_project_id'
# Service Account Key (JSON Content) - RECOMMENDED for CI/CD and Local
# Use the full content of your service-account.json file here.
GCP_SA_KEY='{"type":"service_account", ...}'

# Legacy: File path (Optional)
# GOOGLE_APPLICATION_CREDENTIALS='./firebase-config.json'
GOOGLE_CLIENT_ID='your_google_client_id'
GOOGLE_CLIENT_SECRET='your_google_client_secret'
GOOGLE_CALLBACK_URL='http://localhost:3000/auth/google/callback'
FIREBASE_API_KEY='your_firebase_api_key'

# --- Secrets the server signs with (REQUIRED) ---
# The backend refuses to boot without JWT_SECRET. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use different values per environment and never commit real ones.
JWT_SECRET=
# Signs public report share links (HMAC). Changing it invalidates old links.
RESEARCH_SHARE_SECRET=
# Shared secret for the HTTP cron endpoints (scheduler → API).
CRON_SECRET=

# Enables the POST /auth/dev/token endpoint (mints a session for any email).
# OFF by default. Set to 'true' ONLY for local dev / e2e — NEVER on
# staging/preview/prod, where it is a full auth bypass.
ENABLE_DEV_LOGIN='true'

# --- Web client ---
# The current client (frontend-v2) is served at `/` by default. Set this to
# 'true' to serve the previous client (frontend/, built into ./client) instead
# — a rollback switch that needs no rebuild, because the image carries both.
# FRONTEND_LEGACY=false

# --- Gemini / LLM ---
# Primary (free-tier) key. Serves the base + flash research tiers
# (gemini-3.5-flash-lite, gemini-3.8-flash) and the background tiers
# (extraction, cron scans, summaries, scoring, comment moderation — also
# gemini-3.5-flash-lite since it became the default), all on the free key.
# Background work and interactive "Flash Lite" research therefore share that
# model's free quota at Google.
GEMINI_API_KEY='your_gemini_api_key'
# Secondary (billed) key. Acts as the 429 backup AND is REQUIRED for the gated
# paid-only models — the deep tier's gemini-4-argon and the "-preview" Pro
# models — which are not available on the free key. Leave empty to disable the
# deep tier.
GEMINI_API_KEY_SECONDARY=''

# Optional per-tier model overrides (defaults shown). low=base, medium=flash, deep=pro.
# GEMINI_MODEL_LOW='gemini-3.5-flash-lite'
# GEMINI_MODEL_MEDIUM='gemini-3.8-flash'
# GEMINI_MODEL_DEEP='gemini-4-argon'
# GEMINI_MODEL_EXTRACTION='gemini-3.5-flash-lite'
# NOTE: local text tasks (summary / recommendation / scoring) and comment
# moderation follow GEMINI_FLASH_LITE_MODEL in src/config/configuration.ts
# (gemini-3.5-flash-lite; no env var) — Gemma's 16K TPM / small context made it
# the bottleneck on the paid key. gemini-3.1-flash-lite, the previous default,
# is still recognised: set GEMINI_MODEL_EXTRACTION to it to move extraction
# back, and it remains the last free fallback on a 429.

# --- Currency / FX ---
# OPTIONAL. ExchangeRate-API key (https://www.exchangerate-api.com). When set it
# is the PREFERRED live source (highest update frequency). When absent, the
# service self-heals via keyless public sources (open.er-api.com, Frankfurter/
# ECB), then the DB cache, then a static snapshot — so multi-currency display
# works with zero config. Set this only to get the freshest/most-frequent rates.
# EXCHANGERATE='your_exchangerate_api_key'

# --- Background jobs ---
# The scheduled jobs that run INSIDE the app process outside production
# (30 s price refresh for held/alerted symbols, hourly candle sync, the
# risk/reward scanner, pending-order fills, StockTwits syncs, daily digest,
# queue worker, cleanups). Production never runs them in-process — there the
# same jobs are triggered by GitHub Actions through the cron endpoints.
# Set to 'off' to disable ALL of them in this process, e.g. for a local run on
# seeded demo data (otherwise they overwrite prices from the live providers,
# start research runs and fill seeded pending orders). Unset, or any other
# value, keeps them on. Request-driven behaviour and the cron HTTP endpoints
# are not affected.
# BACKGROUND_JOBS=off

# --- Ticker creation ---
# How many NEW tickers one non-admin user may make the platform start tracking
# per 24 hours (each costs provider calls and a research run). Admins are
# exempt; tickers already tracked are never affected. Over the limit the API
# answers 429 and points to the ticker-request flow. 0 = requests only.
# TICKER_CREATE_DAILY_LIMIT=10

# --- Users' personal API keys, encrypted at rest ---
# A user can save a personal Gemini API key in their profile. With this set,
# it is stored encrypted (AES-256-GCM, bound to the user's id) in
# users.gemini_api_key_enc and never in clear text.
#
#   USER_SECRETS_KEYS="<id>:<base64 of 32 random bytes>[,<id>:<base64>...]"
#
# The FIRST key encrypts; all listed keys can decrypt.
#   Generate a key:   openssl rand -base64 32
#   Example:          USER_SECRETS_KEYS="k1:<output of the command above>"
#
# NOT SET (the default): nothing changes — keys stay in clear text in
#   users.preferences and the application logs one warning when it starts.
# SET: at start the application moves the keys still in clear text into the
#   encrypted column (it logs how many, never a key), and from then on every
#   saved key is encrypted. A malformed value (bad base64, a key that is not
#   32 bytes, a repeated id) stops the application at start, on purpose.
#
# Keep the keys somewhere safe (a secret manager, not this file in git): a
# stored key whose encryption key is lost CANNOT be recovered. The app then
# treats that user as having no personal key (research uses the system key)
# and logs a warning with the user's id; the user has to save the key again.
#
# Rotating: put a NEW key first and keep the old one —
#   USER_SECRETS_KEYS="k2:<new>,k1:<old>"
# — and deploy. At start everything still under k1 is re-encrypted with k2
# (the log line reports "N re-encrypted with the active key, 0 could not be
# decrypted"). Once that has run on every instance, drop k1 on a later deploy.
# Do not remove a key while values under it remain, and do not reuse an id for
# a different key.
# USER_SECRETS_KEYS=
